{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/espace-membre",
      "destination": "/espace-membre.html"
    },
    {
      "source": "/espace-membre.html",
      "destination": "/espace-membre.html"
    }
  ]
}
